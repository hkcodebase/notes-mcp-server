# Path to your notes directory (default: ./notes)
NOTES_DIR=./notes

# Path for ChromaDB storage (default: ./chroma_db)
CHROMA_DIR=./chroma_db

# Embedding model from sentence-transformers hub (default: all-MiniLM-L6-v2)
# Alternatives: all-mpnet-base-v2 (better quality, slower), paraphrase-multilingual-MiniLM-L12-v2 (multilingual)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
